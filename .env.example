#.NET CONFIG
ASPNETCORE_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_LOGGING_LEVEL=Information

# JWT signing key used by the API (required; minimum 32 bytes)
JWT__SECRETKEY=
ASPNETCORE_FRONTEND_URL=http://localhost:5173/

#DATABASE CONFIG
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=map-api
DB_HOST=postgis
DB_PORT=5432

#REDIS CONFIG
REDIS_HOST=redis
REDIS_PORT=6379

#MAIL CONFIG
MAIL_FROM=no-reply@map.local
MAIL_FROM_NAME=Map
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAILPIT_UI_PORT=8025

#ADMIN ACOUNT
SEED_ADMIN_EMAIL=admin@example.pl
SEED_ADMIN_PASSWORD=Admin123!