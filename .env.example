#.NET CONFIG
ASPNETCORE_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_LOGGING_LEVEL=Information

# JWT signing key used by the API (required; minimum 32 bytes)
JWT__SECRETKEY=
ASPNETCORE_FRONTEND_URL=

#DATABASE CONFIG
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=map-api
DB_HOST=postgis
DB_PORT=5432

#REDIS CONFIG
REDIS_HOST=redis
REDIS_PORT=6379

#MAIL CONFIG (defaults point to the local MailPit container; set host, port and credentials for a real SMTP server)
#When SMTP_USERNAME is set, TLS is required: implicit TLS on port 465, STARTTLS on any other port
MAIL_FROM=no-reply@map.local
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

#ADMIN ACOUNT
SEED_ADMIN_EMAIL=admin@example.pl
SEED_ADMIN_PASSWORD=Admin123!